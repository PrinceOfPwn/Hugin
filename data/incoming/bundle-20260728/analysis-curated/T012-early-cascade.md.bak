                 │    4. nt_queue_apc_thread                  │
                 │    5. nt_resume_thread                     │
                 │    6. nt_close (×2)                        │
                 │                                           │
                 │  Error path: nt_free_virtual_memory +     │
                 │   nt_terminate_process + nt_close         │
                 └───────────────────────┬───────────────────┘
                                         │
                                         ▼
                       ┌──────────────────────────────────┐
                       │  crate::recycled (T-001)         │
                       │   — JMP into ntdll 0F 05 C3      │
