{
  "local": {
    "model": "onnx-community/Qwen3.5-4B-Instruct-ONNX",
    "dtype": "q4",
    "max_output_tokens": 700,
    "use_for": [
      "single_record_summary",
      "title_generation",
      "tag_generation",
      "explicit_entity_extraction"
    ]
  },
  "complex": {
    "model": "z-ai/glm-5.2",
    "max_output_tokens": 4000,
    "use_for": [
      "technical_abstraction",
      "cross_document_synthesis",
      "conceptual_graph_generation",
      "technique_candidates",
      "mitre_candidates",
      "attack_chain_extraction",
      "multi_file_relationships",
      "conflicting_claim_resolution",
      "ambiguous_concept_resolution"
    ]
  },
  "batch": {
    "general": {
      "max_records": 6,
      "max_input_chars": 20000
    },
    "complex": {
      "max_records": 2,
      "max_input_chars": 16000
    }
  },
  "thresholds": {
    "claim": 0.68,
    "technique": 0.76,
    "entity": 0.64,
    "relation": 0.76,
    "mitre": 0.86
  },
  "fallback": {
    "on_rate_limit": "next_model",
    "on_timeout": "next_model",
    "on_content_filter": "next_model",
    "on_invalid_schema": "repair_once_then_next_model",
    "on_all_remote_failures": "deterministic_enrichment",
    "manual_review": false
  }
}
