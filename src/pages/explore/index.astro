---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExplorerShell from "../../components/ExplorerShell";
import { galaxies, manifest } from "../../lib/data";

const catalogUrl = `/Hugin${manifest.assets.catalog}`;
const graphUrl = `/Hugin${manifest.assets.graph}`;
---

<BaseLayout
  title="Explore"
  description={`Search and filter ${manifest.counts.coreEntities.toLocaleString()} HUGIN knowledge nodes.`}
>
  <header class="wrap page-head">
    <p class="eyebrow">Complete knowledge catalog</p>
    <h1>Find the record. Then follow its connections.</h1>
    <p class="lede">
      Search techniques, concepts, detections, operational chains, and LGTM research notes.
      Preview any node, then open the full record.
    </p>
  </header>
  <section class="explorer-outer">
    <ExplorerShell
      client:load
      galaxies={galaxies}
      routePrefix="/Hugin"
      dataUrls={{ catalog: catalogUrl, graph: graphUrl }}
    />
  </section>
</BaseLayout>

<style>
  .explorer-outer {
    width: 100%;
    max-width: 100%;
    min-height: 620px;
    padding: 0;
    margin: 0;
  }
</style>
