---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GraphPageShell from "../../components/GraphPageShell";
import { manifest, entities, galaxies, curatedRelations } from "../../lib/data";

// Positions are precomputed at build time (see scripts/build-data.mjs universe
// physics section). The client just reads them and animates orbits.
const graphNodes = entities.map((e) => ({
  id: e.id,
  label: e.title,
  kind: e.kind,
  galaxyId: e.galaxyId,
  category: e.category,
  route: e.route,
  summary: e.summary,
  scope: e.publishState,
  degree: e.degree,
  size: Math.min(11, 2.0 + ((e.mass ?? 2) * 0.4)),
  mass: e.mass,
  orbitOf: e.orbitOf ?? null,
  orbitDistance: e.orbitDistance ?? null,
  orbit: e.orbit ?? null,
  isAttractor: e.isAttractor ?? false,
  position: e.position,
  color: "#9d7cf4",
  tier: e.tier as "S" | "A" | "B" | "C" | undefined,
}));

const graphEdges = curatedRelations.map((r) => ({
  id: r.id,
  source: r.source,
  target: r.target,
  type: r.type,
}));

const positions = Object.fromEntries(
  entities.filter((e) => e.position).map((e) => [e.id, e.position!])
);
// Per-galaxy spin axes — used by the client Kepler solver so satellite motion
// stays in the same orbital plane the server used when computing t=0.
const spinAxes = Object.fromEntries(
  galaxies.filter((g) => g.spinAxis).map((g) => [g.id, g.spinAxis!])
);
const graphData = { nodes: graphNodes, edges: graphEdges, positions, spinAxes };

// Slim entity subset for the filter engine — drop heavy fields (provenance, bodyRef).
const entitiesForFilter = entities.map((e) => ({
  id: e.id,
  slug: e.slug,
  route: e.route,
  title: e.title,
  kind: e.kind,
  category: e.category,
  galaxyId: e.galaxyId,
  subgalaxy: e.subgalaxy,
  summary: e.summary,
  tags: e.tags,
  tier: e.tier,
  mitre: e.mitre,
  bodyRef: "",
  bodyShard: 0,
  degree: e.degree,
  publishState: e.publishState,
  evidenceId: "",
  provenance: [],
  mass: e.mass,
  charCount: e.charCount,
  orbitOf: e.orbitOf ?? null,
  firstSeenAt: e.firstSeenAt ?? null,
  lastUpdatedAt: e.lastUpdatedAt ?? null,
  // Positions are needed by the Minimap (bottom-right top-down projection)
  // so it can plot per-node dots. Server-computed once, ~3 floats × N nodes
  // adds ~60 KB to the island payload — trivial vs the full graph.
  position: e.position ?? undefined,
}));
---

<BaseLayout
  title="Knowledge Graph"
  description={`Explore ${manifest.counts.coreEntities.toLocaleString()} knowledge nodes across structured galaxies in a live 3D universe.`}
>
  <GraphPageShell client:only="react" graphData={graphData} manifest={manifest} entities={entitiesForFilter} />
</BaseLayout>
