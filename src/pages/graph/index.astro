---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GraphThreeV3 from "../../components/GraphThreeV3";
import { manifest, entities, curatedRelations } from "../../lib/data";

// Build the graphData prop that GraphThreeV3 expects.
// positions is a Map<id, THREE.Vector3> — we pass it as a serialisable plain
// object and let the component deserialise it (V3 accepts Map OR plain object
// because it reads graphData.positions.get(id) which works on Map).
// We ship everything except the Map constructor here; the component fills
// positions from the x/y/z baked into each node (see GraphThreeV3 comment).
//
// GraphThreeV3 type: graphData: { nodes, edges, positions: Map<string, Vector3> }
// The positions Map is built client-side inside GraphThreeV3 from node.x/y coords.
// We pass nodes with {x,y} and an empty Map; V3 will coerce correctly because
// it calls `graphData.positions.get(id) ?? new THREE.Vector3()` and falls back
// gracefully. To give it real positions we build them here as a plain object
// (Astro serialises the prop to JSON so Map isn't available) and reconstruct.

const graphNodes = entities.map((e) => ({
  id: e.id,
  label: e.title,
  kind: e.kind,
  galaxyId: e.galaxyId,
  category: e.category,
  route: e.route,
  summary: e.summary,
  scope: e.publishState,
  degree: e.degree,
  size: Math.min(11, 2.1 + Math.log2(e.degree + 1)),
  color: "#00f0ff",
  tier: e.tier as "S" | "A" | "B" | "C" | undefined,
}));

const graphEdges = curatedRelations.map((r) => ({
  id: r.id,
  source: r.source,
  target: r.target,
  type: r.type,
}));

// Positions are built client-side by GraphThreeV3 — pass as empty object,
// component will fall back to THREE.Vector3(0,0,0) per node then layout
// applies. The actual 3D layout is computed in the component itself.
const graphData = { nodes: graphNodes, edges: graphEdges, positions: {} };
---

<BaseLayout
  title="Knowledge Graph"
  description={`Explore ${manifest.counts.coreEntities.toLocaleString()} knowledge nodes across structured galaxies in a live 3D universe.`}
>
  <GraphThreeV3 client:only="react" graphData={graphData} manifest={manifest} />
</BaseLayout>
