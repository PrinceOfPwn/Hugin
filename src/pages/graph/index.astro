---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GraphThreeV3 from "../../components/GraphThreeV3";
import { manifest, entities, curatedRelations } from "../../lib/data";
import fs from "node:fs";
import path from "node:path";

// Load pre-computed 3D positions from build-data.mjs output.
// Falls back to empty object if file doesn't exist yet (first-run or local dev).
const posFile = path.resolve("src/generated/graph-positions.json");
const rawPositions: Record<string, { x: number; y: number; z: number }> =
  fs.existsSync(posFile)
    ? JSON.parse(fs.readFileSync(posFile, "utf8"))
    : {};

const graphNodes = entities.map((e) => ({
  id: e.id,
  label: e.title,
  kind: e.kind,
  galaxyId: e.galaxyId,
  category: e.category,
  route: e.route,
  summary: e.summary,
  scope: e.publishState,
  degree: e.degree,
  size: Math.min(11, 2.1 + Math.log2(e.degree + 1)),
  color: "#00f0ff",
  tier: e.tier as "S" | "A" | "B" | "C" | undefined,
}));

const graphEdges = curatedRelations.map((r) => ({
  id: r.id,
  source: r.source,
  target: r.target,
  type: r.type,
}));

// Pass positions as a plain {id:{x,y,z}} record — GraphThreeV3 converts it
// to a Map<string, THREE.Vector3> internally.
const graphData = { nodes: graphNodes, edges: graphEdges, positions: rawPositions };
---

<BaseLayout
  title="Knowledge Graph"
  description={`Explore ${manifest.counts.coreEntities.toLocaleString()} knowledge nodes across structured galaxies in a live 3D universe.`}
>
  <GraphThreeV3 client:only="react" graphData={graphData} manifest={manifest} />
</BaseLayout>
