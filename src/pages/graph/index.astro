---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GraphPageShell from "../../components/GraphPageShell";
import { manifest } from "../../lib/data";

const graphUrl = `/Hugin${manifest.assets.graph}`;
const catalogUrl = `/Hugin${manifest.assets.catalog}`;
---

<BaseLayout
  title="Knowledge Graph"
  description={`Explore ${manifest.counts.coreEntities.toLocaleString()} knowledge nodes across structured galaxies in a live 3D universe.`}
>
  <GraphPageShell
    client:load
    manifest={manifest}
    dataUrls={{ graph: graphUrl, catalog: catalogUrl }}
  />
</BaseLayout>
