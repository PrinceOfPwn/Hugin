---
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";
import BaseLayout from "../layouts/BaseLayout.astro";
import { bodyFor, curatedRelations, entityById, evidenceFor } from "../lib/data";
import type { Entity, Relation, EvidenceRecord } from "../lib/types";
import { cleanBodyMarkdown, parseAndCleanSummary } from "../lib/summaryParser";

const { entity } = Astro.props as { entity: Entity };

const rawBody = cleanBodyMarkdown(bodyFor(entity));
const html = rawBody
  ? sanitizeHtml(await marked.parse(rawBody, { gfm: true }), {
      allowedTags: sanitizeHtml.defaults.allowedTags.concat(["img", "pre", "code", "span", "div"]),
      allowedAttributes: {
        a: ["href", "title", "target", "rel"],
        img: ["src", "alt", "title"],
        code: ["class"],
        span: ["class", "style"],
        div: ["class", "style"],
      },
      allowedSchemes: ["https", "http", "mailto"],
    })
  : "";

const structuredInfo = parseAndCleanSummary(entity.summary, entity.title);
const {
  cleanSummary,
  tier,
  mitre,
  tags,
  files,
  linesOfInterest,
  keyFunctions,
  requires: metaRequires,
  enables: metaEnables,
} = structuredInfo;

const effectiveTier = tier || entity.tier;
const effectiveTags = tags && tags.length ? tags : entity.tags;
const effectiveMitre = mitre && mitre.length ? mitre : entity.mitre;

// === AI enrichment + bridge fields (not yet in the shared Entity type, always optional) ===
interface AIEnrichment {
  summary?: string;
  mitre?: string[];
  apis?: string[];
  iocs?: string[];
  tags?: string[];
  chains_with?: string[];
  alternatives?: string[];
  counters?: string[];
  stealth?: number;
  complexity?: number;
  os_requirements?: string;
  confidence?: number;
  model?: string;
  enrichedAt?: string;
}
interface BridgeInfo {
  total_neighbors: number;
  own_galaxy: number;
  foreign_galaxies: Record<string, number>;
}
type Enriched = Entity & { _ai?: AIEnrichment; bridge_score?: number; _bridge?: BridgeInfo };
const enriched = entity as Enriched;
const ai = enriched._ai;
const bridgeScore = enriched.bridge_score ?? 0;
const bridge = enriched._bridge;
const isBridge = bridgeScore >= 0.4;
const foreignGalaxyEntries = bridge
  ? Object.entries(bridge.foreign_galaxies).sort((a, b) => b[1] - a[1])
  : [];
const maxForeignCount = foreignGalaxyEntries.length ? foreignGalaxyEntries[0][1] : 1;

function resolveIds(ids?: string[]): Entity[] {
  if (!ids || !ids.length) return [];
  const out: Entity[] = [];
  for (const id of ids) {
    const found = entityById.get(id);
    if (found) out.push(found);
  }
  return out;
}
const aiChainsWith = resolveIds(ai?.chains_with);
const aiAlternatives = resolveIds(ai?.alternatives);
const aiCounters = resolveIds(ai?.counters);
const hasAttackContext = aiChainsWith.length > 0 || aiAlternatives.length > 0 || aiCounters.length > 0;

function meterSegments(value: number | undefined, max = 5): boolean[] {
  const v = value ?? 0;
  return Array.from({ length: max }, (_, i) => i < v);
}

// === Neighbors (curated relations touching this entity) ===
const rawRelations = curatedRelations.filter(
  (e) => e.source === entity.id || e.target === entity.id
);
const seen = new Set<string>();
const neighbors: Array<{
  edge: Relation;
  entity: Entity;
  direction: "incoming" | "outgoing";
}> = [];
for (const edge of rawRelations) {
  const direction = edge.source === entity.id ? "outgoing" : "incoming";
  const otherId = direction === "outgoing" ? edge.target : edge.source;
  const other = entityById.get(otherId);
  if (!other) continue;
  const k = `${edge.type}:${other.id}:${direction}`;
  if (seen.has(k)) continue;
  seen.add(k);
  neighbors.push({ edge, entity: other, direction });
}
neighbors.sort((a, b) => b.entity.degree - a.entity.degree);

// === Edge type colors (synced with the 3D graph palette) ===
const EDGE_COLORS: Record<string, string> = {
  enables: "#00f0ff",
  counters: "#ff334c",
  detects: "#38ff6b",
  chains_to: "#ffb800",
  requires: "#e13ffb",
  implements: "#ffffff",
  derived_from: "#00e5bf",
  alternative_to: "#9d4edd",
  related: "#8896b0",
  concept_link: "#00b3e6",
  reference: "#6b7280",
  enhances: "#ffdc4c",
};
const edgeColor = (t: string) => EDGE_COLORS[t] ?? "#8896b0";

// Grouped by relation type only (not direction) so each edge semantic gets exactly one
// collapsible section, matching the color language used in the 3D neighborhood view.
const groupsMap = new Map<string, { type: string; items: typeof neighbors }>();
for (const n of neighbors) {
  if (!groupsMap.has(n.edge.type)) groupsMap.set(n.edge.type, { type: n.edge.type, items: [] });
  groupsMap.get(n.edge.type)!.items.push(n);
}
const relatedGroups = Array.from(groupsMap.values())
  .map((g) => ({
    ...g,
    color: edgeColor(g.type),
    count: g.items.length,
    preview: g.items.slice(0, 3).map((i) => i.entity.title),
  }))
  .sort((a, b) => b.count - a.count);

// === Kind flags — every one of the 12 kinds gets an explicit branch below ===
const isTechnique = entity.kind === "technique";
const isQA = entity.kind === "tradecraft_qa";
const isChain = entity.kind === "chain";
const isDetection = entity.kind === "detection";
const isConcept = entity.kind === "concept";
const isLgtmNote = entity.kind === "lgtm_note";
const isPlaybook = entity.kind === "playbook";
const isSource = entity.kind === "source" || entity.kind === "source-extract";
const isDocRef = entity.kind === "documentation" || entity.kind === "reference";
const isPattern = entity.kind === "pattern";
const isKnownKind =
  isTechnique || isQA || isChain || isDetection || isConcept || isLgtmNote ||
  isPlaybook || isSource || isDocRef || isPattern;
const hasRail = isTechnique || isPattern;

const KIND_GLYPH: Record<string, string> = {
  technique: "★",
  tradecraft_qa: "?",
  chain: "⧫",
  detection: "⬡",
  concept: "●",
  lgtm_note: "≈",
  playbook: "▪",
  source: "◆",
  "source-extract": "◆",
  documentation: "▲",
  reference: "·",
  pattern: "·",
};
const glyph = KIND_GLYPH[entity.kind] ?? "·";

const GALAXY_COLORS: Record<string, string> = {
  techniques: "#ff2244",
  internals: "#00f0ff",
  defenses: "#39ff14",
  chains: "#ffb700",
  evidence: "#00e5ff",
  sources: "#e040fb",
  gaps: "#ff5555",
  architecture: "#9d4edd",
  tradecraft_qa: "#00e5bf",
};
const gColor = GALAXY_COLORS[entity.galaxyId] ?? "#00f0ff";

const tierColor = (t?: string) => {
  if (!t) return "#8896b0";
  const u = t.toUpperCase();
  if (u === "S") return "#ff334c";
  if (u === "A") return "#ffb800";
  if (u === "B") return "#00f0ff";
  if (u === "C") return "#8896b0";
  return "#8896b0";
};
const tColor = tierColor(effectiveTier);

// === Evidence, sorted by quality (worst last) ===
const evidenceRecs: EvidenceRecord[] = evidenceFor(entity.id, 25)
  .slice()
  .sort((a, b) => b.qualityScore - a.qualityScore);
const qColorFor = (q: number) => (q >= 80 ? "#38ff6b" : q >= 60 ? "#ffb800" : "#ff334c");

// === Kind-specific neighbor views ===
const referencedBy = neighbors.filter(
  (n) => n.direction === "incoming" && (n.entity.kind === "technique" || n.entity.kind === "detection")
);

const chainSteps = neighbors
  .filter((n) => n.direction === "outgoing" && n.edge.type === "chains_to")
  .sort((a, b) => (a.edge.rank ?? 999) - (b.edge.rank ?? 999));

const catchesList = neighbors
  .filter((n) => n.edge.type === "detects" || n.edge.type === "counters")
  .sort((a, b) => b.entity.degree - a.entity.degree);

const playbookRequires = neighbors.filter(
  (n) => n.direction === "outgoing" && n.edge.type === "requires"
);
const playbookEnables = neighbors.filter(
  (n) => n.direction === "outgoing" && n.edge.type === "enables"
);

const locText = (l: any) => (typeof l === "string" ? l : l?.loc ?? "");
const locNote = (l: any) => (typeof l === "string" ? "" : l?.note ?? "");
const primaryFile = files && files.length ? files[0] : undefined;
const primaryLoc = linesOfInterest && linesOfInterest.length ? locText(linesOfInterest[0]) : undefined;

// === Q&A: title is the question, body/summary carries the answer + any inlined steps ===
// Steps in ingested QA samples arrive as "1. foo 2. bar 3. baz" run together in one sentence,
// not as markdown list items, so a lookahead-based split is needed rather than a line split.
function extractSteps(text: string): string[] {
  if (!text) return [];
  const matches = text.match(/\d+\.\s+((?:(?!\d+\.\s).)+)/gs);
  if (!matches || matches.length < 2) return [];
  return matches.map((m) => m.replace(/^\d+\.\s*/, "").trim()).filter((s) => s.length > 0);
}
const qaQuestion = entity.title;
const qaSteps = isQA ? extractSteps(`${cleanSummary} ${rawBody}`) : [];
const playbookSteps = isPlaybook ? extractSteps(rawBody || cleanSummary) : [];

function buildJsonLd(e: Entity, summary: string) {
  const base: Record<string, unknown> = {
    "@context": "https://schema.org",
    name: e.title,
    identifier: e.id,
    description: summary,
  };
  if (isQA) {
    return {
      ...base,
      "@type": "QAPage",
      mainEntity: {
        "@type": "Question",
        name: qaQuestion,
        text: summary,
        acceptedAnswer: { "@type": "Answer", text: summary },
      },
    };
  }
  if (isChain) {
    return {
      ...base,
      "@type": "HowTo",
      step: chainSteps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.entity.title })),
    };
  }
  if (isTechnique) {
    return {
      ...base,
      "@type": "TechArticle",
      proficiencyLevel: effectiveTier,
      about: (effectiveMitre ?? []).join(", "),
      ...(ai?.os_requirements ? { operatingSystem: ai.os_requirements } : {}),
    };
  }
  if (isConcept || isDocRef) {
    return { ...base, "@type": "DefinedTerm" };
  }
  if (isSource) {
    return { ...base, "@type": "SoftwareSourceCode", codeRepository: primaryFile };
  }
  return { ...base, "@type": "Article" };
}
const jsonLd = buildJsonLd(entity, cleanSummary || entity.summary);
---

<BaseLayout title={entity.title} description={cleanSummary || entity.summary} jsonLd={jsonLd}>
  <article
    class="ep"
    style={`--accent:${gColor};--gcolor:${gColor};--tcolor:${tColor};`}
  >
    {/* === BREADCRUMB === */}
    <nav class="crumb">
      <div class="trail">
        <a href="/Hugin/" class="back">← Universe</a>
        <span class="sep">&gt;</span>
        <span class="subg">{entity.category}</span>
        <span class="sep">&gt;</span>
        <span class="subg" style={`color:${gColor}`}>{entity.galaxyId}</span>
        {entity.subgalaxy && (
          <>
            <span class="sep">&gt;</span>
            <span class="subg">{entity.subgalaxy}</span>
          </>
        )}
      </div>
      <a
        class="threedee"
        href={`/Hugin/graph/?focus=${encodeURIComponent(entity.id)}&mode=neighborhood&edges=curated&depth=1`}
        title="Open 3D neighborhood"
      >
        <span class="ico">◈</span>
        <span class="lbl">3D neighborhood</span>
      </a>
    </nav>

    {/* === HERO === */}
    <header class="hero">
      <div class="eyebrow-row">
        <span class="glyph" data-kind={entity.kind}>{glyph}</span>
        <div class="eyebrow">
          <span class="kind">{entity.kind}</span>
          <span class="dot">·</span>
          <span class="galaxy">{entity.galaxyId}</span>
          {effectiveTier && (
            <>
              <span class="dot">·</span>
              <span class="tier">{effectiveTier}</span>
            </>
          )}
          {isTechnique && effectiveMitre && effectiveMitre.length > 0 && (
            <>
              <span class="dot">·</span>
              <span class="mitre">{effectiveMitre.join(" ")}</span>
            </>
          )}
        </div>
      </div>

      {isBridge && bridge && (
        <div class="bridge-badge">
          <span class="ico">◈</span>
          Multi-domain concept — bridges {Object.keys(bridge.foreign_galaxies).length} galax{Object.keys(bridge.foreign_galaxies).length === 1 ? "y" : "ies"}
        </div>
      )}

      <h1 class={isSource ? "title title-mono" : isLgtmNote ? "title title-note" : "title"}>
        {isQA ? qaQuestion : entity.title}
      </h1>

      <p class="summary">{cleanSummary || entity.summary}</p>

      {effectiveTags && effectiveTags.length > 0 && (
        <div class="tags">
          {effectiveTags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )}
      <div class="rec">REC · {entity.id} · DEG {entity.degree}</div>
    </header>

    {/* === AI ENRICHMENT (top position, kinds without a rail) === */}
    {ai && !hasRail && (
      <section class="ai-panel ai-panel-top">
        <div class="ai-head">
          <span class="ai-pill">AI-enriched · {ai.model || "Qwen3-4B"}</span>
        </div>
        <div class="ai-grid">
          {ai.stealth != null && (
            <div class="meter-row">
              <span class="meter-label">Stealth</span>
              <span class="meter">
                {meterSegments(ai.stealth).map((on) => <span class={on ? "seg on" : "seg"} />)}
              </span>
            </div>
          )}
          {ai.complexity != null && (
            <div class="meter-row">
              <span class="meter-label">Complexity</span>
              <span class="meter">
                {meterSegments(ai.complexity).map((on) => <span class={on ? "seg on" : "seg"} />)}
              </span>
            </div>
          )}
          {ai.os_requirements && (
            <div class="fact-row">
              <span class="fact-label">OS</span>
              <span class="fact-value mono">{ai.os_requirements}</span>
            </div>
          )}
        </div>
        {ai.apis && ai.apis.length > 0 && (
          <div class="chip-block">
            <span class="chip-block-label">APIs</span>
            <div class="chip-row">
              {ai.apis.map((a) => <span class="chip chip-mono">{a}</span>)}
            </div>
          </div>
        )}
        {ai.iocs && ai.iocs.length > 0 && (
          <div class="chip-block">
            <span class="chip-block-label">IOCs</span>
            <div class="chip-row">
              {ai.iocs.map((a) => <span class="chip chip-mono chip-ioc">{a}</span>)}
            </div>
          </div>
        )}
        {ai.confidence != null && (
          <div class="ai-confidence">Model confidence: {ai.confidence}/5</div>
        )}
      </section>
    )}

    {bridge && !hasRail && foreignGalaxyEntries.length > 0 && (
      <section class="bridge-strip-wrap">
        <div class="label">Cross-galaxy neighbors</div>
        <div class="bridge-strip">
          {foreignGalaxyEntries.map(([gId, count]) => (
            <div class="bridge-bar-row">
              <span class="bridge-gname" style={`color:${GALAXY_COLORS[gId] ?? "#8896b0"}`}>{gId}</span>
              <div class="bridge-bar-track">
                <div
                  class="bridge-bar-fill"
                  style={`width:${Math.max(6, (count / maxForeignCount) * 100)}%;background:${GALAXY_COLORS[gId] ?? "#8896b0"}`}
                />
              </div>
              <span class="bridge-count">{count}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* === MAIN AREA === */}
    {hasRail ? (
      <div class="layout-split">
        <div class="main-col">
          {isTechnique && (
            <>
              {files && files.length > 0 && (
                <div class="body-section">
                  <div class="label">Implementation</div>
                  <div class="files-box">
                    {files.map((f) => (
                      <div class="file">
                        <span class="bullet">◆</span>
                        <span class="path">{f}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {linesOfInterest && linesOfInterest.length > 0 && (
                <div class="body-section">
                  <div class="label">Key Code Locations</div>
                  <div class="lines-of-interest">
                    {linesOfInterest.map((l) => (
                      <div class="line">
                        <span class="loc">{locText(l)}</span>
                        {locNote(l) && <span class="note"> {locNote(l)}</span>}
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {html && (
                <div class="body-section">
                  <div class="label">Full Technical Specification</div>
                  <div class="prose" set:html={html} />
                </div>
              )}
              {hasAttackContext && (
                <div class="body-section">
                  <div class="label">Attack Context</div>
                  <div class="attack-context">
                    {aiChainsWith.length > 0 && (
                      <div class="attack-group attack-chains">
                        <div class="attack-group-head">Chains with</div>
                        {aiChainsWith.map((n) => (
                          <a class="mini-card" href={`/Hugin${n.route}`}>
                            <span class="g">{KIND_GLYPH[n.kind] ?? "·"}</span>
                            <span class="t">{n.title}</span>
                          </a>
                        ))}
                      </div>
                    )}
                    {aiAlternatives.length > 0 && (
                      <div class="attack-group attack-alts">
                        <div class="attack-group-head">Alternatives</div>
                        {aiAlternatives.map((n) => (
                          <a class="mini-card" href={`/Hugin${n.route}`}>
                            <span class="g">{KIND_GLYPH[n.kind] ?? "·"}</span>
                            <span class="t">{n.title}</span>
                          </a>
                        ))}
                      </div>
                    )}
                    {aiCounters.length > 0 && (
                      <div class="attack-group attack-counters">
                        <div class="attack-group-head">Countered by</div>
                        {aiCounters.map((n) => (
                          <a class="mini-card" href={`/Hugin${n.route}`}>
                            <span class="g">{KIND_GLYPH[n.kind] ?? "·"}</span>
                            <span class="t">{n.title}</span>
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )}
            </>
          )}

          {isPattern && (
            <>
              {html ? (
                <div class="body-section">
                  <div class="label">Pattern</div>
                  <div class="prose" set:html={html} />
                </div>
              ) : (
                <p class="empty">No body content.</p>
              )}
              {hasAttackContext && (
                <div class="body-section">
                  <div class="label">Related Patterns</div>
                  <div class="attack-context">
                    {aiAlternatives.length > 0 && (
                      <div class="attack-group attack-alts">
                        <div class="attack-group-head">Alternatives</div>
                        {aiAlternatives.map((n) => (
                          <a class="mini-card" href={`/Hugin${n.route}`}>
                            <span class="g">{KIND_GLYPH[n.kind] ?? "·"}</span>
                            <span class="t">{n.title}</span>
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )}
            </>
          )}
        </div>

        <aside class="rail">
          {ai && (
            <div class="rail-section ai-panel">
              <div class="ai-head">
                <span class="ai-pill">AI-enriched · {ai.model || "Qwen3-4B"}</span>
              </div>
              {ai.stealth != null && (
                <div class="meter-row">
                  <span class="meter-label">Stealth</span>
                  <span class="meter">
                    {meterSegments(ai.stealth).map((on) => <span class={on ? "seg on" : "seg"} />)}
                  </span>
                </div>
              )}
              {ai.complexity != null && (
                <div class="meter-row">
                  <span class="meter-label">Complexity</span>
                  <span class="meter">
                    {meterSegments(ai.complexity).map((on) => <span class={on ? "seg on" : "seg"} />)}
                  </span>
                </div>
              )}
              {ai.os_requirements && (
                <div class="fact-row">
                  <span class="fact-label">OS</span>
                  <span class="fact-value mono">{ai.os_requirements}</span>
                </div>
              )}
              {ai.apis && ai.apis.length > 0 && (
                <div class="chip-block">
                  <span class="chip-block-label">APIs</span>
                  <div class="chip-row">
                    {ai.apis.map((a) => <span class="chip chip-mono">{a}</span>)}
                  </div>
                </div>
              )}
              {ai.iocs && ai.iocs.length > 0 && (
                <div class="chip-block">
                  <span class="chip-block-label">IOCs</span>
                  <div class="chip-row">
                    {ai.iocs.map((a) => <span class="chip chip-mono chip-ioc">{a}</span>)}
                  </div>
                </div>
              )}
              {ai.confidence != null && (
                <div class="ai-confidence">Model confidence: {ai.confidence}/5</div>
              )}
            </div>
          )}
          {keyFunctions && keyFunctions.length > 0 && (
            <div class="rail-section">
              <div class="rail-title">Key Functions</div>
              <div class="chip-row">
                {keyFunctions.map((f) => <span class="chip chip-mono">{f}</span>)}
              </div>
            </div>
          )}
          {bridge && foreignGalaxyEntries.length > 0 && (
            <div class="rail-section">
              <div class="rail-title">Cross-galaxy neighbors</div>
              <div class="bridge-strip">
                {foreignGalaxyEntries.map(([gId, count]) => (
                  <div class="bridge-bar-row">
                    <span class="bridge-gname" style={`color:${GALAXY_COLORS[gId] ?? "#8896b0"}`}>{gId}</span>
                    <div class="bridge-bar-track">
                      <div
                        class="bridge-bar-fill"
                        style={`width:${Math.max(6, (count / maxForeignCount) * 100)}%;background:${GALAXY_COLORS[gId] ?? "#8896b0"}`}
                      />
                    </div>
                    <span class="bridge-count">{count}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>
    ) : (
      <section class="body single">
        {isQA && (
          <div class="qa-block">
            <div class="label">Answer</div>
            {html ? <div class="prose" set:html={html} /> : <p class="prose">{cleanSummary || entity.summary}</p>}
            {qaSteps.length > 0 && (
              <div class="body-section">
                <div class="label">Operator Steps</div>
                <ol class="op-steps">
                  {qaSteps.map((s) => <li>{s}</li>)}
                </ol>
              </div>
            )}
          </div>
        )}

        {isChain && (
          <>
            {chainSteps.length > 0 && (
              <div class="body-section">
                <div class="label">Sequence · {chainSteps.length} steps</div>
                <div class="timeline">
                  {chainSteps.map((s, i) => (
                    <a class="timeline-step" href={`/Hugin${s.entity.route}`}>
                      <div class="timeline-rail">
                        <div class="num">{String(i + 1).padStart(2, "0")}</div>
                        {i < chainSteps.length - 1 && <div class="connector" />}
                      </div>
                      <div class="info">
                        <div class="t">{s.entity.title}</div>
                        <div class="s">
                          {s.entity.summary || s.entity.subgalaxy || s.entity.galaxyId}
                        </div>
                      </div>
                      <div class="rank">r{String(s.edge.rank ?? i + 1).padStart(2, "0")}</div>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {html && <div class="prose" set:html={html} />}
          </>
        )}

        {isDetection && (
          <>
            {catchesList.length > 0 && (
              <div class="catches-card">
                <div class="head">
                  <span class="ico">⬡</span>
                  <span class="htxt">DETECTS</span>
                  <span class="cnt">{catchesList.length}</span>
                </div>
                {catchesList.map((n) => (
                  <a class="item" href={`/Hugin${n.entity.route}`}>
                    <span class="g">★</span>
                    <span class="t">{n.entity.title}</span>
                    <span class="k">{n.entity.galaxyId}</span>
                    <span class="etype">{n.edge.type}</span>
                  </a>
                ))}
              </div>
            )}
            {html && <div class="prose" set:html={html} />}
          </>
        )}

        {isConcept && (
          <>
            <blockquote class="concept-def">{cleanSummary || entity.summary}</blockquote>
            {html && <div class="prose" set:html={html} />}
            {referencedBy.length > 0 && (
              <div class="referenced-by">
                <div class="head">
                  <span>Where this appears</span>
                  <span class="cnt">{referencedBy.length}</span>
                </div>
                {referencedBy.map((n) => (
                  <a href={`/Hugin${n.entity.route}`}>
                    <span class="g">{KIND_GLYPH[n.entity.kind] ?? "·"}</span>
                    <span class="t">{n.entity.title}</span>
                    <span class="k">{n.entity.galaxyId}</span>
                  </a>
                ))}
              </div>
            )}
          </>
        )}

        {isLgtmNote && (
          <>
            <pre class="verbatim">{entity.summary}</pre>
            {html && <div class="prose" set:html={html} />}
            {evidenceRecs.length > 0 && (
              <div class="body-section">
                <div class="label">Related Evidence</div>
                {evidenceRecs.map((r) => (
                  <div class="evidence-card">
                    <div class="ehead">
                      <span class="et">{r.title}</span>
                      <span class="epill" style={`--qc:${qColorFor(r.qualityScore)}`}>Q {r.qualityScore}</span>
                    </div>
                    <div class="etopic">{r.topic}</div>
                    <p class="esummary">{r.summary}</p>
                    {r.keyCues && r.keyCues.length > 0 && (
                      <div class="chip-row">
                        {r.keyCues.map((c) => <span class="chip">{c}</span>)}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </>
        )}

        {isPlaybook && (
          <>
            {html && <div class="prose" set:html={html} />}
            {playbookSteps.length > 0 && (
              <div class="body-section">
                <div class="label">Checklist</div>
                <div class="playbook-cards">
                  {playbookSteps.map((s, i) => (
                    <div class="playbook-card">
                      <span class="pnum">{String(i + 1).padStart(2, "0")}</span>
                      <span class="ptext">{s}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {(playbookRequires.length > 0 || (metaRequires && metaRequires.length > 0)) && (
              <div class="body-section">
                <div class="label">Prerequisites</div>
                {playbookRequires.length > 0 ? (
                  <div class="mini-card-row">
                    {playbookRequires.map((n) => (
                      <a class="mini-card" href={`/Hugin${n.entity.route}`}>
                        <span class="g">{KIND_GLYPH[n.entity.kind] ?? "·"}</span>
                        <span class="t">{n.entity.title}</span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <div class="chip-row">
                    {metaRequires!.map((r) => <span class="chip">{r}</span>)}
                  </div>
                )}
              </div>
            )}
            {(playbookEnables.length > 0 || (metaEnables && metaEnables.length > 0)) && (
              <div class="body-section">
                <div class="label">Outputs</div>
                {playbookEnables.length > 0 ? (
                  <div class="mini-card-row">
                    {playbookEnables.map((n) => (
                      <a class="mini-card" href={`/Hugin${n.entity.route}`}>
                        <span class="g">{KIND_GLYPH[n.entity.kind] ?? "·"}</span>
                        <span class="t">{n.entity.title}</span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <div class="chip-row">
                    {metaEnables!.map((r) => <span class="chip">{r}</span>)}
                  </div>
                )}
              </div>
            )}
          </>
        )}

        {isSource && (
          <>
            <div class="source-chip-row">
              {primaryFile && <span class="chip chip-mono file-chip">{primaryFile}</span>}
              {primaryLoc && <span class="chip chip-mono line-chip">{primaryLoc}</span>}
            </div>
            {html ? <div class="prose source-mono" set:html={html} /> : <p class="empty">No body content.</p>}
          </>
        )}

        {isDocRef && (
          <>
            {html ? <div class="prose doc-body" set:html={html} /> : <p class="empty">No body content.</p>}
          </>
        )}

        {!isKnownKind && (
          <>
            {html ? <div class="prose" set:html={html} /> : <p class="empty">No body content.</p>}
          </>
        )}
      </section>
    )}

    {/* === EVIDENCE (generic, any kind other than lgtm_note which shows it inline above) === */}
    {!isLgtmNote && evidenceRecs.length > 0 && (
      <section class="evidence-section">
        <div class="heading">
          <span class="htxt">ANONYMOUS EVIDENCE</span>
          <span class="dim">/ {evidenceRecs.length} records</span>
        </div>
        {evidenceRecs.map((r) => (
          <div class="evidence-card">
            <div class="ehead">
              <span class="et">{r.title}</span>
              <span class="epill" style={`--qc:${qColorFor(r.qualityScore)}`}>Q {r.qualityScore}</span>
            </div>
            <div class="etopic">{r.topic}</div>
            <p class="esummary">{r.summary}</p>
            {r.keyCues && r.keyCues.length > 0 && (
              <div class="chip-row">
                {r.keyCues.map((c) => <span class="chip">{c}</span>)}
              </div>
            )}
          </div>
        ))}
      </section>
    )}

    {/* === RELATED KNOWLEDGE (grouped strictly by relation type) === */}
    {relatedGroups.length > 0 && (
      <section class="rk">
        <div class="heading">
          <span class="htxt">RELATED KNOWLEDGE</span>
          <span class="dim">
            / {relatedGroups.length} groups · {neighbors.length} nodes
          </span>
        </div>
        {relatedGroups.map((g) => (
          <details class="rk-group" style={`--groupcolor:${g.color}`}>
            <summary>
              <span class="chev">▸</span>
              <span class="type">{g.type}</span>
              <span class="count">{String(g.count).padStart(2, "0")}</span>
              <span class="preview">
                {g.preview.join(" · ")}
                {g.count > 3 ? ` +${g.count - 3}` : ""}
              </span>
            </summary>
            <div class="content">
              {g.items.map((n) => (
                <a class="rk-node" href={`/Hugin${n.entity.route}`}>
                  <span class="arrow">{n.direction === "outgoing" ? "→" : "←"}</span>
                  <span class="glyph">{KIND_GLYPH[n.entity.kind] ?? "·"}</span>
                  <div class="info">
                    <div class="meta">
                      <span class="m-kind">{n.entity.kind}</span>
                      <span class="m-sep">·</span>
                      <span class="m-galaxy">{n.entity.galaxyId}</span>
                      {n.entity.tier && (
                        <>
                          <span class="m-sep">·</span>
                          <span class="m-tier">{n.entity.tier}</span>
                        </>
                      )}
                    </div>
                    <div class="t">{n.entity.title}</div>
                    <div class="s">{n.entity.summary}</div>
                  </div>
                  {n.edge.rationale && (
                    <div class="rationale">
                      <span class="rtext">{n.edge.rationale}</span>
                      {n.edge.rank != null && (
                        <span class="rank">r{n.edge.rank}</span>
                      )}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </details>
        ))}
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // Code fences are the only place operators copy-paste from; everything else on the page is prose.
  document.querySelectorAll(".ep .prose pre").forEach((pre) => {
    const btn = document.createElement("button");
    btn.className = "copy-btn";
    btn.type = "button";
    btn.textContent = "Copy";
    btn.addEventListener("click", () => {
      const code = pre.querySelector("code");
      const text = code ? code.textContent ?? "" : pre.textContent ?? "";
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = "Copy"), 1500);
      });
    });
    (pre as HTMLElement).style.position = "relative";
    pre.appendChild(btn);
  });
</script>

