---
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";
import BaseLayout from "../layouts/BaseLayout.astro";
import { bodyFor, curatedRelations, entityById, evidenceFor } from "../lib/data";
import type { Entity, Relation, EvidenceRecord } from "../lib/types";
import { cleanBodyMarkdown, parseAndCleanSummary } from "../lib/summaryParser";

const { entity } = Astro.props as { entity: Entity };

const rawBody = cleanBodyMarkdown(bodyFor(entity));
const html = rawBody
  ? sanitizeHtml(await marked.parse(rawBody, { gfm: true }), {
      allowedTags: sanitizeHtml.defaults.allowedTags.concat(["img", "pre", "code", "span", "div"]),
      allowedAttributes: {
        a: ["href", "title", "target", "rel"],
        img: ["src", "alt", "title"],
        code: ["class"],
        span: ["class", "style"],
        div: ["class", "style"],
      },
      allowedSchemes: ["https", "http", "mailto"],
    })
  : "";

const structuredInfo = parseAndCleanSummary(entity.summary, entity.title);
const { cleanSummary, tier, mitre, tags, files, linesOfInterest } = structuredInfo;

const effectiveTier = tier || entity.tier;
const effectiveTags = tags && tags.length ? tags : entity.tags;
const effectiveMitre = mitre && mitre.length ? mitre : entity.mitre;

// === Neighbors with direction ===
const rawRelations = curatedRelations.filter(
  (e) => e.source === entity.id || e.target === entity.id
);
const seen = new Set<string>();
const neighbors: Array<{
  edge: Relation;
  entity: Entity;
  direction: "incoming" | "outgoing";
}> = [];
for (const edge of rawRelations) {
  const direction = edge.source === entity.id ? "outgoing" : "incoming";
  const otherId = direction === "outgoing" ? edge.target : edge.source;
  const other = entityById.get(otherId);
  if (!other) continue;
  const k = `${edge.type}:${other.id}`;
  if (seen.has(k)) continue;
  seen.add(k);
  neighbors.push({ edge, entity: other, direction });
}
neighbors.sort((a, b) => b.entity.degree - a.entity.degree);

// === Edge type colors (synced with 3D view) ===
const EDGE_COLORS: Record<string, string> = {
  enables: "#00f0ff",
  counters: "#ff334c",
  detects: "#38ff6b",
  chains_to: "#ffb800",
  requires: "#e13ffb",
  implements: "#ffffff",
  derived_from: "#00e5bf",
  alternative_to: "#9d4edd",
  related: "#8896b0",
  concept_link: "#00b3e6",
  reference: "#6b7280",
  enhances: "#ffdc4c",
};
const edgeColor = (t: string) => EDGE_COLORS[t] ?? "#8896b0";

// === Group by direction + edge type ===
const groupsMap = new Map<
  string,
  { direction: "incoming" | "outgoing"; type: string; items: typeof neighbors }
>();
for (const n of neighbors) {
  const key = `${n.direction}:${n.edge.type}`;
  if (!groupsMap.has(key)) {
    groupsMap.set(key, { direction: n.direction, type: n.edge.type, items: [] });
  }
  groupsMap.get(key)!.items.push(n);
}
const signalGroups = Array.from(groupsMap.values())
  .map((g) => ({
    ...g,
    color: edgeColor(g.type),
    count: g.items.length,
    preview: g.items.slice(0, 3).map((i) => i.entity.title),
  }))
  .sort((a, b) => {
    if (a.direction !== b.direction) return a.direction === "outgoing" ? -1 : 1;
    return b.count - a.count;
  });

// === Kind flags ===
const isTechnique = entity.kind === "technique";
const isConcept = entity.kind === "concept";
const isChain = entity.kind === "chain";
const isDetection = entity.kind === "detection";
const isSource = entity.kind === "source" || entity.kind === "source-extract";
const isLgtmNote = entity.kind === "lgtm_note";
const isCentered = ["playbook", "documentation", "reference", "pattern"].includes(
  entity.kind
);

const KIND_GLYPH: Record<string, string> = {
  technique: "★",
  chain: "⧫",
  detection: "⬡",
  concept: "●",
  lgtm_note: "≈",
  playbook: "▪",
  source: "◆",
  "source-extract": "◆",
  documentation: "▲",
  reference: "·",
  pattern: "·",
};
const glyph = KIND_GLYPH[entity.kind] ?? "·";

const GALAXY_COLORS: Record<string, string> = {
  techniques: "#ff2244",
  internals: "#00f0ff",
  defenses: "#39ff14",
  chains: "#ffb700",
  evidence: "#00e5ff",
  sources: "#e040fb",
  gaps: "#ff5555",
  architecture: "#9d4edd",
  tradecraft_qa: "#00e5bf",
};
const gColor = GALAXY_COLORS[entity.galaxyId] ?? "#00f0ff";

const tierColor = (t?: string) => {
  if (!t) return "#8896b0";
  const u = t.toUpperCase();
  if (u === "S") return "#ff334c";  // critical / novel
  if (u === "A") return "#ffb800";  // advanced
  if (u === "B") return "#00f0ff";  // solid
  if (u === "C") return "#8896b0";  // basic
  return "#8896b0";
};
const tColor = tierColor(effectiveTier);

// === Evidence for lgtm_note ===
const evidenceRecs = evidenceFor(entity.id, 1);
const evidenceRec: EvidenceRecord | undefined = evidenceRecs[0];
const qScore = evidenceRec?.qualityScore ?? 0;
const qColor = qScore >= 80 ? "#38ff6b" : qScore >= 60 ? "#ffb800" : "#ff334c";

// === Kind-specific neighbor views ===
const referencedBy = neighbors
  .filter((n) => n.direction === "incoming" && n.entity.kind === "technique")
  .slice(0, 5);

const chainSteps = neighbors
  .filter((n) => n.direction === "outgoing" && n.edge.type === "chains_to")
  .sort((a, b) => (a.edge.rank ?? 999) - (b.edge.rank ?? 999));

const catchesList = neighbors
  .filter((n) => n.direction === "outgoing" && n.edge.type === "detects")
  .sort((a, b) => b.entity.degree - a.entity.degree);

const locText = (l: any) => (typeof l === "string" ? l : l?.loc ?? "");
const locNote = (l: any) => (typeof l === "string" ? "" : l?.note ?? "");
---

<BaseLayout title={entity.title} description={cleanSummary || entity.summary}>
  <article
    class="ep"
    style={`--accent:${gColor};--gcolor:${gColor};--tcolor:${tColor};`}
  >
    {/* === BREADCRUMB === */}
    <nav class="crumb">
      <div class="trail">
        <a href="/Hugin/" class="back">← Universe</a>
        <span class="sep">&gt;</span>
        <span class="subg">{entity.category}</span>
        <span class="sep">&gt;</span>
        <span class="subg" style={`color:${gColor}`}>{entity.galaxyId}</span>
        {entity.subgalaxy && (
          <>
            <span class="sep">&gt;</span>
            <span class="subg">{entity.subgalaxy}</span>
          </>
        )}
      </div>
      <a
        class="threedee"
        href={`/Hugin/graph/?focus=${encodeURIComponent(entity.id)}&mode=neighborhood&edges=curated&depth=1`}
        title="Open 3D neighborhood"
      >
        <span class="ico">◈</span>
        <span class="lbl">3D neighborhood</span>
      </a>
    </nav>

    {/* === HERO === */}
    <header class="hero">
      <div class="eyebrow-row">
        <span class="glyph" data-kind={entity.kind}>{glyph}</span>
        <div class="eyebrow">
          <span class="kind">{entity.kind}</span>
          <span class="dot">·</span>
          <span class="galaxy">{entity.galaxyId}</span>
          {effectiveTier && (
            <>
              <span class="dot">·</span>
              <span class="tier">{effectiveTier}</span>
            </>
          )}
          {isTechnique && effectiveMitre && effectiveMitre.length > 0 && (
            <>
              <span class="dot">·</span>
              <span class="mitre">{effectiveMitre.join(" ")}</span>
            </>
          )}
        </div>
      </div>
      <h1 class={isSource ? "title title-mono" : "title"}>{entity.title}</h1>
      <p class="summary">{cleanSummary || entity.summary}</p>
      {effectiveTags && effectiveTags.length > 0 && (
        <div class="tags">
          {effectiveTags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )}
      <div class="rec">REC · {entity.id} · DEG {entity.degree}</div>
    </header>

    {/* === SIGNAL TRAFFIC === */}
    {signalGroups.length > 0 && (
      <section class="signal">
        <div class="heading">
          <span class="htxt">SIGNAL TRAFFIC</span>
          <span class="dim">/ {neighbors.length} edges · {signalGroups.length} channels</span>
        </div>
        <div class="rows">
          {signalGroups.map((g) => (
            <div class="signal-row" style={`--rowcolor:${g.color}`}>
              <div class="label">
                <span class="arrow">{g.direction === "outgoing" ? "→" : "←"}</span>
                <span class="type">{g.type}</span>
              </div>
              <div class="count">{String(g.count).padStart(2, "0")}</div>
              <div class="targets">
                {g.preview.map((t, i) => (
                  <>
                    {i > 0 && <span class="tsep">·</span>}
                    <span class="tname">{t}</span>
                  </>
                ))}
                {g.count > 3 && <span class="more">+{g.count - 3}</span>}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* === BODY (kind-adaptive) === */}
    <section class="body">
      {isCentered && (
        <div class="centered">
          {html ? (
            <div class="prose" set:html={html} />
          ) : (
            <p class="empty">No body content.</p>
          )}
        </div>
      )}

      {isTechnique && (
        <>
          {files && files.length > 0 && (
            <div class="body-section">
              <div class="label">Implementation</div>
              <div class="files-box">
                {files.map((f) => (
                  <div class="file">
                    <span class="bullet">◆</span>
                    <span class="path">{f}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
          {linesOfInterest && linesOfInterest.length > 0 && (
            <div class="body-section">
              <div class="label">Key Code Locations</div>
              <div class="lines-of-interest">
                {linesOfInterest.map((l) => (
                  <div class="line">
                    <span class="loc">{locText(l)}</span>
                    {locNote(l) && <span class="note"> {locNote(l)}</span>}
                  </div>
                ))}
              </div>
            </div>
          )}
          {html && (
            <div class="body-section">
              <div class="label">Full Technical Specification</div>
              <div class="prose" set:html={html} />
            </div>
          )}
        </>
      )}

      {isConcept && (
        <>
          <blockquote class="concept-def">{cleanSummary || entity.summary}</blockquote>
          {html && <div class="prose" set:html={html} />}
          {referencedBy.length > 0 && (
            <div class="referenced-by">
              <div class="head">
                <span>Referenced by</span>
                <span class="cnt">{referencedBy.length}</span>
              </div>
              {referencedBy.map((n) => (
                <a href={`/Hugin${n.entity.route}`}>
                  <span class="g">★</span>
                  <span class="t">{n.entity.title}</span>
                  <span class="k">{n.entity.galaxyId}</span>
                </a>
              ))}
            </div>
          )}
        </>
      )}

      {isChain && (
        <>
          {chainSteps.length > 0 && (
            <div class="body-section">
              <div class="label">Sequence · {chainSteps.length} steps</div>
              <div class="chain-steps">
                {chainSteps.map((s, i) => (
                  <a class="chain-step" href={`/Hugin${s.entity.route}`}>
                    <div class="num">{String(i + 1).padStart(2, "0")}</div>
                    <div class="info">
                      <div class="t">{s.entity.title}</div>
                      <div class="s">
                        {s.entity.summary || s.entity.subgalaxy || s.entity.galaxyId}
                      </div>
                    </div>
                    <div class="rank">r{String(s.edge.rank ?? i + 1).padStart(2, "0")}</div>
                  </a>
                ))}
              </div>
            </div>
          )}
          {html && <div class="prose" set:html={html} />}
        </>
      )}

      {isDetection && (
        <>
          {catchesList.length > 0 && (
            <div class="catches-card">
              <div class="head">
                <span class="ico">⬡</span>
                <span class="htxt">CATCHES</span>
                <span class="cnt">{catchesList.length}</span>
              </div>
              {catchesList.map((n) => (
                <a class="item" href={`/Hugin${n.entity.route}`}>
                  <span class="g">★</span>
                  <span class="t">{n.entity.title}</span>
                  <span class="k">{n.entity.galaxyId}</span>
                </a>
              ))}
            </div>
          )}
          {html && <div class="prose" set:html={html} />}
        </>
      )}

      {isSource && html && <div class="prose" set:html={html} />}

      {isLgtmNote && (
        <>
          {evidenceRec && (
            <div class="lgtm-badge" style={`--qcolor:${qColor};--qcolor-bg:${qColor}14;`}>
              <span class="lbl">QUALITY</span>
              <span class="score">Q {evidenceRec.qualityScore}</span>
            </div>
          )}
          {evidenceRec?.keyCues && evidenceRec.keyCues.length > 0 && (
            <div class="key-cues">
              {evidenceRec.keyCues.map((c) => (
                <span class="cue">{c}</span>
              ))}
            </div>
          )}
          {html && <div class="prose" set:html={html} />}
        </>
      )}
    </section>

    {/* === CONNECTED KNOWLEDGE === */}
    {signalGroups.length > 0 && (
      <section class="ck">
        <div class="heading">
          <span class="htxt">CONNECTED KNOWLEDGE</span>
          <span class="dim">
            / {signalGroups.length} groups · {neighbors.length} nodes
          </span>
        </div>
        {signalGroups.map((g) => (
          <details class="ck-group" style={`--groupcolor:${g.color}`}>
            <summary>
              <span class="chev">▸</span>
              <span class="arrow">{g.direction === "outgoing" ? "→" : "←"}</span>
              <span class="type">{g.type}</span>
              <span class="count">{String(g.count).padStart(2, "0")}</span>
              <span class="preview">
                {g.preview.join(" · ")}
                {g.count > 3 ? ` +${g.count - 3}` : ""}
              </span>
            </summary>
            <div class="content">
              {g.items.map((n) => (
                <a class="ck-node" href={`/Hugin${n.entity.route}`}>
                  <span class="glyph">{KIND_GLYPH[n.entity.kind] ?? "·"}</span>
                  <div class="info">
                    <div class="meta">
                      <span class="m-kind">{n.entity.kind}</span>
                      <span class="m-sep">·</span>
                      <span class="m-galaxy">{n.entity.galaxyId}</span>
                      {n.entity.tier && (
                        <>
                          <span class="m-sep">·</span>
                          <span class="m-tier">{n.entity.tier}</span>
                        </>
                      )}
                    </div>
                    <div class="t">{n.entity.title}</div>
                    <div class="s">{n.entity.summary}</div>
                  </div>
                  {n.edge.rationale && (
                    <div class="rationale">
                      <span class="rtext">{n.edge.rationale}</span>
                      {n.edge.rank != null && (
                        <span class="rank">r{n.edge.rank}</span>
                      )}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </details>
        ))}
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* === BASE === */
  .ep {
    --bg: #000005;
    --fg: #e8e8f0;
    --fg-dim: #8896b0;
    --fg-faint: #4a5060;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.18);
    --accent: #00f0ff;
    --bg-panel: rgba(255, 255, 255, 0.015);
    --bg-panel-hover: rgba(255, 255, 255, 0.045);
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 96px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    color: var(--fg);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    background: var(--bg);
  }
  .ep .mono,
  .ep .rec,
  .ep .crumb,
  .ep .eyebrow,
  .ep .tag,
  .ep .signal-row,
  .ep .ck-group summary,
  .ep .ck-node .meta,
  .ep .files-box,
  .ep .lines-of-interest,
  .ep .lgtm-badge,
  .ep .key-cues .cue,
  .ep .referenced-by .head,
  .ep .catches-card .head,
  .ep .chain-step .num,
  .ep .chain-step .rank,
  .ep .ck-node .glyph,
  .ep .title-mono,
  .ep .threedee {
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", monospace;
  }

  /* === CRUMB === */
  .crumb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0 16px;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    color: var(--fg-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .crumb .trail {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .crumb a {
    color: var(--fg-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .crumb .back {
    color: var(--fg);
  }
  .crumb .sep {
    color: var(--fg-faint);
  }
  .crumb .subg {
    color: var(--fg-dim);
  }
  .threedee {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-decoration: none;
    padding: 5px 9px;
    border: 1px solid var(--border-strong);
    background: linear-gradient(180deg, rgba(0, 240, 255, 0.06), rgba(0, 240, 255, 0));
    transition: all 0.2s;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .threedee:hover {
    background: linear-gradient(180deg, rgba(0, 240, 255, 0.18), rgba(0, 240, 255, 0.04));
    border-color: var(--accent);
    box-shadow: 0 0 20px -6px var(--accent);
  }
  .threedee .ico {
    font-size: 12px;
    line-height: 1;
  }

  /* === HERO === */
  .hero {
    padding: 36px 0 32px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .hero .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .hero .glyph {
    font-size: 22px;
    line-height: 1;
    color: var(--accent);
    text-shadow: 0 0 18px var(--accent), 0 0 36px rgba(0, 240, 255, 0.35);
    animation: glyph-pulse 3.5s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes glyph-pulse {
    0%, 100% {
      text-shadow: 0 0 16px var(--accent), 0 0 32px rgba(0, 240, 255, 0.25);
    }
    50% {
      text-shadow: 0 0 28px var(--accent), 0 0 52px rgba(0, 240, 255, 0.55);
    }
  }
  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .hero .eyebrow .dot {
    color: var(--fg-faint);
  }
  .hero .eyebrow .kind {
    color: var(--fg);
  }
  .hero .eyebrow .galaxy {
    color: var(--gcolor);
    text-shadow: 0 0 12px var(--gcolor);
  }
  .hero .eyebrow .tier {
    color: var(--tcolor);
    text-shadow: 0 0 10px var(--tcolor);
  }
  .hero .eyebrow .mitre {
    color: var(--accent);
    font-size: 10px;
    padding: 2px 6px;
    border: 1px solid var(--border-strong);
    background: rgba(0, 240, 255, 0.04);
    letter-spacing: 0.08em;
  }
  .hero .title {
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 18px;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hero .title-mono {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    word-break: break-all;
    background: linear-gradient(180deg, rgba(0, 240, 255, 0.04), transparent);
    padding: 8px 14px;
    border-left: 2px solid var(--accent);
    display: inline-block;
    max-width: 100%;
  }
  .hero .summary {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    max-width: 780px;
    margin: 0 0 20px;
  }
  .hero .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .hero .tag {
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 3px 7px;
    border: 1px solid var(--border);
    color: var(--fg-dim);
    text-transform: lowercase;
    background: rgba(255, 255, 255, 0.02);
  }
  .hero .rec {
    font-size: 10px;
    color: var(--fg-faint);
    letter-spacing: 0.1em;
  }
  .hero .rec::before {
    content: "▸ ";
    color: var(--accent);
  }

  /* === SIGNAL TRAFFIC === */
  .signal {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .signal::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 25%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: traffic-sweep 4.5s linear infinite;
    opacity: 0;
  }
  @keyframes traffic-sweep {
    0% {
      transform: translateX(-100%);
      opacity: 0;
    }
    10% {
      opacity: 0.7;
    }
    90% {
      opacity: 0.7;
    }
    100% {
      transform: translateX(400%);
      opacity: 0;
    }
  }
  .signal .heading,
  .ck .heading,
  .body-section .label,
  .referenced-by .head,
  .catches-card .head {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "JetBrains Mono", monospace;
  }
  .signal .heading::before,
  .ck .heading::before,
  .body-section .label::before {
    content: "▸";
    color: var(--accent);
    font-size: 9px;
  }
  .ck .heading::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
