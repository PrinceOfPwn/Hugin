{
  "name": "hugin-knowledge-universe",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "onnxruntime-node": "1.25.1",
    "sharp": "^0.35.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "data:import": "node scripts/import-public-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:mitre": "node scripts/build-mitre-index.mjs",
    "data:mitre:sync": "node scripts/sync-mitre-enterprise.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:mercury:audit": "node scripts/mercury-audit-graph.mjs",
    "ingest:detect": "node scripts/detect-format.v2.mjs",
    "ingest:normalize": "node scripts/apply-mapping.v2.mjs",
    "ingest:enrich": "node scripts/enrich-records.mjs",
    "ingest:compile": "node scripts/compile-canonical.mjs",
    "qa:normalize": "node scripts/normalize-samples.mjs",
    "qa:enrich": "node scripts/enrich-qa.mjs",
    "qa:import": "node scripts/import-qa.mjs",
    "qa:ingest": "node scripts/ingest.mjs hugin/samples_normalized.jsonl",
    "qa:ingest:fast": "node scripts/ingest.mjs hugin/samples_normalized.jsonl --no-model",
    "qa:ingest:model": "node scripts/ingest.mjs hugin/samples_normalized.jsonl",
    "prebuild": "npm run data:build && npm run data:mitre && npm run data:validate",
    "build": "astro build && pagefind --site dist",
    "site:build": "astro build && pagefind --site dist",
    "site:validate": "node scripts/check-public-artifact.mjs",
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "astro check && npm run data:validate",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:budgets": "node scripts/check-budgets.mjs",
    "test:mitre": "node tests/mitre-index.test.mjs",
    "test:mercury": "node --check scripts/mercury-audit-graph.mjs && node tests/mercury-audit.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "@astrojs/sitemap": "latest",
    "@google/genai": "latest",
    "@huggingface/transformers": "latest",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "@react-three/postprocessing": "latest",
    "astro": "latest",
    "d3-force-3d": "latest",
    "graphology": "latest",
    "marked": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sanitize-html": "latest",
    "sigma": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@lhci/cli": "latest",
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "latest",
    "@types/three": "latest",
    "pagefind": "latest",
    "typescript": "latest"
  }
}
